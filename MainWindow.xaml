<Window x:Class="Orbit.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Orbit — настройки" Width="940" Height="740" MinWidth="790" MinHeight="610" WindowStartupLocation="CenterScreen">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,24"><StackPanel><TextBlock Text="◉  ORBIT" FontSize="30" FontWeight="Bold" Foreground="#7AE4CE"/><TextBlock Text="Твои приложения. Одно движение." Foreground="#A8B6CA" FontSize="14" Margin="0,7,0,0"/></StackPanel><Button Content="Проверить колесо" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Preview_Click"/></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12"><TextBlock Text="Приложения в колесе" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="От верхнего сектора, по часовой стрелке · до 12" Foreground="#91A4BE" Margin="0,6,0,0" FontSize="12"/></StackPanel>
    <ListBox x:Name="AppsList" Grid.Row="1" SelectionChanged="Selection_Changed" MouseDoubleClick="Edit_Click"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding Icon}" Width="30" Height="30"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" FontSize="10" Foreground="#8DA1BC" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,4,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    <WrapPanel Grid.Row="2" Margin="0,14,0,0"><Button Content="+ Добавить" Click="Add_Click"/><Button x:Name="EditButton" Content="Изменить" Click="Edit_Click"/><Button x:Name="UpButton" Content="↑" Click="Up_Click" Padding="12,10"/><Button x:Name="DownButton" Content="↓" Click="Down_Click" Padding="12,10"/><Button x:Name="RemoveButton" Content="×" Click="Remove_Click" Padding="12,10"/></WrapPanel>
   </Grid></Border>
   <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="14" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <TextBlock Text="Управление" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Удерживай бинд, веди мышь в нужную сторону и отпускай." Foreground="#A8B6CA" Margin="0,10,0,18"/>
    <Button x:Name="BindButton" Content="F8" Click="Bind_Click" Background="#245A54" FontSize="17"/><TextBlock x:Name="BindHint" Text="Нажми, чтобы задать клавишу или сочетание." FontSize="11" Foreground="#91A4BE" Margin="0,8,0,18"/>
    <TextBlock Text="Размер колеса"/><Slider x:Name="SizeSlider" Minimum="300" Maximum="640" TickFrequency="20" IsSnapToTickEnabled="True" Margin="0,8,0,16" ValueChanged="Options_Changed"/>
    <TextBlock Text="Чувствительность движения"/><Slider x:Name="SensitivitySlider" Minimum="0.4" Maximum="2.5" Margin="0,8,0,16" ValueChanged="Options_Changed"/>
    <TextBlock Text="Непрозрачность колеса"/><Slider x:Name="OpacitySlider" Minimum="0.5" Maximum="1" Margin="0,8,0,16" ValueChanged="Options_Changed"/>
    <CheckBox x:Name="StartupCheck" Content="Запускать вместе с Windows" Foreground="#D4DFEE" Margin="0,0,0,16" Click="Startup_Click"/>
    <TextBlock Text="Колесо — в центре экрана с мышью. Курсор скрыт, после выбора возвращается обратно. Esc — отмена." FontSize="12" Foreground="#91A4BE"/>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,18,0,0"><Button Content="Свернуть в трей" DockPanel.Dock="Right" Click="Hide_Click"/><TextBlock x:Name="Status" Text="Готово. Настройки сохраняются автоматически." Foreground="#91A4BE" VerticalAlignment="Center" Margin="0,0,16,0"/></DockPanel>
 </Grid>
</Window>
