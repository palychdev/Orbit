<Window x:Class="Orbit.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Orbit" Width="800" Height="600" MinWidth="680" MinHeight="520" WindowStartupLocation="CenterScreen">
 <Grid x:Name="RootCanvas" Background="{DynamicResource CanvasBrush}">
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="62"/></Grid.RowDefinitions>
  <Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Viewbox Width="27" Height="27" Margin="0,0,10,0"><Canvas Width="32" Height="32"><Path Stroke="{DynamicResource TextBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 16,3 A 13,13 0 0 1 28,12 M 28,20 A 13,13 0 0 1 20,28 M 12,28 A 13,13 0 0 1 3,16 M 4,10 A 13,13 0 0 1 10,4"/><Ellipse Width="6" Height="6" Fill="{DynamicResource TextBrush}" Canvas.Left="13" Canvas.Top="13"/></Canvas></Viewbox>
    <TextBlock Text="Orbit" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </StackPanel>
   <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="9" Padding="3" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><RadioButton x:Name="AppsTab" Content="Приложения" GroupName="Page" IsChecked="True" Checked="Page_Changed"/><RadioButton x:Name="SettingsTab" Content="Настройки" GroupName="Page" Checked="Page_Changed"/></StackPanel></Border>
   <Button x:Name="ThemeButton" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource IconButton}" Click="Theme_Click" ToolTip="Светлая тема" AutomationProperties.Name="Светлая тема">
    <Path x:Name="ThemeGlyph" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="17" Height="17" Stretch="Uniform" Data="M12,7 A5,5 0 1 1 11.99,7 M12,0 L12,3 M12,21 L12,24 M0,12 L3,12 M21,12 L24,12 M3.5,3.5 L5.5,5.5 M18.5,18.5 L20.5,20.5 M3.5,20.5 L5.5,18.5 M18.5,5.5 L20.5,3.5"/>
   </Button>
  </Grid>
  <Grid Grid.Row="1" Margin="36,10,36,0">
   <Grid x:Name="AppsPage"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
    <Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Top"><TextBlock Text="Приложения" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="CountLabel" Text="3" FontSize="15" Foreground="{DynamicResource SecondaryBrush}" Margin="12,7,0,0"/></StackPanel>
     <Button x:Name="AddButton" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource PrimaryButton}" Click="Add_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="Добавить"/></StackPanel></Button>
    </Grid>
    <Grid x:Name="ListArea" Grid.Row="1">
     <Border x:Name="ListSurface" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="12" VerticalAlignment="Top" MaxHeight="{Binding ActualHeight, ElementName=ListArea}">
      <ListBox x:Name="AppsList" SelectionChanged="Selection_Changed" MouseDoubleClick="Edit_Click" AutomationProperties.Name="Приложения в колесе">
       <ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Path}"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Slot}" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" FontSize="12"/>
        <Grid Grid.Column="1"><Border Background="{DynamicResource HoverBrush}" CornerRadius="7"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/></Border><Image Source="{Binding Icon}" Width="32" Height="32"/></Grid>
        <StackPanel Grid.Column="2" Margin="14,0,10,0"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding FileName}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,3,0,0"/></StackPanel>
        <Button Grid.Column="3" Content="&#xE76C;" Style="{StaticResource IconButton}" Width="24" Height="28" MinHeight="28" Padding="4" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Tag="{Binding}" Click="RowEdit_Click" ToolTip="Изменить" AutomationProperties.Name="Изменить приложение"/>
       </Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Border>
     <StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Пока пусто" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Добавь приложение или ярлык." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel>
    </Grid>
    <Grid Grid.Row="2" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Button x:Name="UpButton" Content="&#xE70E;" Style="{StaticResource IconButton}" Click="Up_Click" ToolTip="Переместить выше" AutomationProperties.Name="Переместить выше"/><Button x:Name="DownButton" Content="&#xE70D;" Style="{StaticResource IconButton}" Click="Down_Click" ToolTip="Переместить ниже" AutomationProperties.Name="Переместить ниже"/><TextBlock Text="По часовой стрелке, начиная сверху" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="EditButton" Content="&#xE70F;" Style="{StaticResource IconButton}" Click="Edit_Click" ToolTip="Изменить приложение" AutomationProperties.Name="Изменить приложение"/><Button x:Name="RemoveButton" Content="&#xE74D;" Style="{StaticResource IconButton}" Click="Remove_Click" ToolTip="Удалить из колеса" AutomationProperties.Name="Удалить из колеса"/></StackPanel>
    </Grid>
   </Grid>
   <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <TextBlock Text="Настройки" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,24"/>
     <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="20,16"><StackPanel>
      <Grid Margin="0,0,0,20"><TextBlock Text="Вызов колеса" VerticalAlignment="Center"/><Button x:Name="BindButton" HorizontalAlignment="Right" MinWidth="88" Content="F8" Click="Bind_Click" ToolTip="Изменить сочетание клавиш" AutomationProperties.Name="Сочетание клавиш"/></Grid>
      <Grid Margin="0,0,0,6"><TextBlock Text="Размер"/><TextBlock x:Name="SizeValue" Text="440 px" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryBrush}"/></Grid>
      <Slider x:Name="SizeSlider" Minimum="300" Maximum="640" TickFrequency="20" IsSnapToTickEnabled="True" Margin="0,0,0,14" ValueChanged="Options_Changed" AutomationProperties.Name="Размер колеса"/>
      <Grid Margin="0,0,0,6"><TextBlock Text="Чувствительность"/><TextBlock x:Name="SensitivityValue" Text="1,0×" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryBrush}"/></Grid>
      <Slider x:Name="SensitivitySlider" Minimum="0.4" Maximum="2.5" SmallChange="0.1" Margin="0,0,0,14" ValueChanged="Options_Changed" AutomationProperties.Name="Чувствительность мыши"/>
      <Grid Margin="0,0,0,6"><TextBlock Text="Непрозрачность"/><TextBlock x:Name="OpacityValue" Text="94%" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryBrush}"/></Grid>
      <Slider x:Name="OpacitySlider" Minimum="0.5" Maximum="1" SmallChange="0.05" ValueChanged="Options_Changed" AutomationProperties.Name="Непрозрачность колеса"/>
     </StackPanel></Border>
     <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,16,0,0"><CheckBox x:Name="StartupCheck" Content="Запускать с Windows" Click="Startup_Click"/></Border>
     <TextBlock x:Name="BindHint" Visibility="Collapsed" Text="" Style="{StaticResource MutedText}" Margin="0,14,0,0"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Border Grid.Row="2" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Margin="28,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="Status" Text="Готово" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="310"/><Button x:Name="UndoButton" Content="Вернуть" Visibility="Collapsed" Background="Transparent" Margin="8,0,0,0" Click="Undo_Click"/></StackPanel>
   <Button x:Name="FooterBind" Grid.Column="1" Content="F8" Margin="12,0,12,0" Padding="10,4" VerticalAlignment="Center" Click="FooterBind_Click" ToolTip="Изменить сочетание клавиш" AutomationProperties.Name="Изменить сочетание клавиш"/>
   <Button Grid.Column="2" Content="Готово" VerticalAlignment="Center" Padding="18,6" Click="Hide_Click"/>
  </Grid></Border>
 </Grid>
</Window>
