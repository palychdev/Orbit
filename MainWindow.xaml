<Window x:Class="Orbit.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Orbit"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Style="{StaticResource {x:Type Window}}" Title="Orbit"
 Width="720" Height="480" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource CanvasBrush}">
  <Grid x:Name="RootCanvas" Background="{DynamicResource CanvasBrush}">
   <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <local:AppTitleBar x:Name="Header" ThemeRequested="Theme_Click"/>
   <Grid Grid.Row="1" Margin="24,0,24,16">
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
    <Grid>
     <Border HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="3">
      <StackPanel Orientation="Horizontal">
       <RadioButton x:Name="AppsTab" IsChecked="True" GroupName="Page" Checked="Page_Changed"><StackPanel Orientation="Horizontal"><TextBlock Text="Приложения"/><TextBlock x:Name="CountLabel" Text="3" Foreground="{DynamicResource SecondaryBrush}" Margin="8,0,0,0"/></StackPanel></RadioButton>
       <RadioButton x:Name="SettingsTab" Content="Настройки" GroupName="Page" Checked="Page_Changed"/>
      </StackPanel>
     </Border>
     <Button x:Name="AddButton" Content="Добавить" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="100" Click="Add_Click"/>
    </Grid>
    <Grid Grid.Row="1">
     <Grid x:Name="AppsPage">
      <Grid x:Name="ListArea" VerticalAlignment="Top">
       <Border x:Name="ListSurface" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="40"/></Grid.RowDefinitions>
         <ListBox x:Name="AppsList" SelectionChanged="Selection_Changed" MouseDoubleClick="Edit_Click" AutomationProperties.Name="Приложения в колесе" ToolTip="Порядок секторов: сверху по часовой стрелке">
          <ListBox.ItemTemplate><DataTemplate>
           <Grid ToolTip="{Binding Path}"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Slot}" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" FontSize="12"/>
            <Grid Grid.Column="1" Width="32" Height="32">
             <local:FilledIcon Kind="App" Width="24" Height="24" Foreground="{DynamicResource SecondaryBrush}"><local:FilledIcon.Style><Style TargetType="local:FilledIcon"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:FilledIcon.Style></local:FilledIcon>
             <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,8,0"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding FileName}" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
            <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="28" Height="28" MinHeight="28" Padding="7" Tag="{Binding}" Click="RowEdit_Click" ToolTip="Изменить" AutomationProperties.Name="Изменить приложение"><local:FilledIcon Kind="Right" Width="12" Height="12"/></Button>
           </Grid>
          </DataTemplate></ListBox.ItemTemplate>
         </ListBox>
         <Grid Grid.Row="1" Margin="8,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="UpButton" Style="{StaticResource IconButton}" Click="Up_Click" ToolTip="Выше" AutomationProperties.Name="Переместить выше"><local:FilledIcon Kind="Up" Width="15" Height="15"/></Button><Button x:Name="DownButton" Style="{StaticResource IconButton}" Click="Down_Click" ToolTip="Ниже" AutomationProperties.Name="Переместить ниже"><local:FilledIcon Kind="Down" Width="15" Height="15"/></Button></StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="EditButton" Style="{StaticResource IconButton}" Click="Edit_Click" ToolTip="Изменить" AutomationProperties.Name="Изменить приложение"><local:FilledIcon Kind="Edit" Width="15" Height="15"/></Button><Button x:Name="RemoveButton" Style="{StaticResource IconButton}" Click="Remove_Click" ToolTip="Удалить" AutomationProperties.Name="Удалить из колеса"><local:FilledIcon Kind="Trash" Width="15" Height="15"/></Button></StackPanel>
         </Grid>
        </Grid>
       </Border>
      </Grid>
      <StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Пока пусто" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Добавь приложение или ярлык." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel>
     </Grid>
     <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel>
         <Grid Margin="0,0,0,16"><TextBlock Text="Вызов колеса" VerticalAlignment="Center"/><Button x:Name="BindButton" Content="F8" MinWidth="84" HorizontalAlignment="Right" Click="Bind_Click" AutomationProperties.Name="Сочетание клавиш"/></Grid>
         <Grid><TextBlock Text="Размер"/><TextBlock x:Name="SizeValue" Text="440 px" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryBrush}"/></Grid>
         <Slider x:Name="SizeSlider" Minimum="300" Maximum="640" TickFrequency="20" IsSnapToTickEnabled="True" Margin="0,4,0,12" ValueChanged="Options_Changed" AutomationProperties.Name="Размер колеса"/>
         <Grid><TextBlock Text="Чувствительность"/><TextBlock x:Name="SensitivityValue" Text="1,0×" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryBrush}"/></Grid>
         <Slider x:Name="SensitivitySlider" Minimum="0.4" Maximum="2.5" SmallChange="0.1" Margin="0,4,0,0" ValueChanged="Options_Changed" AutomationProperties.Name="Чувствительность мыши"/>
        </StackPanel>
       </Border>
       <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,0"><CheckBox x:Name="StartupCheck" Content="Запускать с Windows" Click="Startup_Click"/></Border>
       <TextBlock x:Name="BindHint" Visibility="Collapsed" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
      </StackPanel>
     </ScrollViewer>
    </Grid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Вызов" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/><Button x:Name="FooterBind" Content="F8" Padding="10,4" Click="FooterBind_Click" ToolTip="Изменить бинд" AutomationProperties.Name="Изменить сочетание клавиш"/></StackPanel>
     <Grid Grid.Column="1" VerticalAlignment="Center" Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Visibility="Collapsed" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Button Grid.Column="1" x:Name="UndoButton" Content="Вернуть" Visibility="Collapsed" Background="Transparent" Click="Undo_Click"/></Grid>
     <Button Grid.Column="2" Content="Готово" MinWidth="84" VerticalAlignment="Center" Click="Hide_Click"/>
    </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>
