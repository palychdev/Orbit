<UserControl x:Class="Orbit.AppTitleBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Orbit" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Height="44">
 <Grid Background="{DynamicResource CanvasBrush}">
  <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
   <Button Background="Transparent" Padding="0" MinHeight="28" Click="About_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Об Orbit" AutomationProperties.Name="Об Orbit"><StackPanel Orientation="Horizontal"><local:FilledIcon Kind="Aperture" Width="18" Height="18" Margin="0,0,9,0"/><TextBlock x:Name="Caption" Text="Orbit" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button>
  </StackPanel>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
   <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Width="32" Height="32" Padding="6" Margin="0,0,8,0" Click="Theme_Click" AutomationProperties.Name="Светлая тема" ToolTip="Светлая тема"><local:FilledIcon x:Name="ThemeGlyph" Kind="Sun" Width="16" Height="16"/></Button>
   <Button x:Name="MinimizeButton" Style="{StaticResource IconButton}" Width="36" Height="32" Click="Minimize_Click" ToolTip="Свернуть" AutomationProperties.Name="Свернуть"><local:FilledIcon Kind="Minimize" Width="12" Height="12"/></Button>
   <Button Style="{StaticResource IconButton}" Width="36" Height="32" Click="Close_Click" ToolTip="Закрыть" AutomationProperties.Name="Закрыть"><local:FilledIcon Kind="Close" Width="11" Height="11"/></Button>
  </StackPanel>
 </Grid>
</UserControl>
